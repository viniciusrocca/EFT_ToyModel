Cell["\<\
\\frac{2 \\sqrt{\\lambda } \\left(x_t \\left(x_t+2 x+\\log \
(x)-2\\right)-(x-1)^2 \\log (x)\\right)-4 \\left(x_t
   \\left(x_t+x^2+x-2\\right)-(x-1)^3\\right) \\log \
\\left(\\frac{\\sqrt{\\lambda }-x_t+x+1}{2 \\sqrt{x}}\\right)}{128 \\pi
   ^4 \\sqrt{\\lambda } x_t^2}\
\>", "Output",
 CellChangeTimes->{
  3.909821617860457*^9, {3.9098220176445427`*^9, 3.909822025377672*^9}, 
   3.9098221510516768`*^9, 3.909822258520343*^9, 3.909823003562557*^9, 
