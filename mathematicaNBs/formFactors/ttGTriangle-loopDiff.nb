 RowBox[{"TeXForm", "[", "deltaCTLexp", "]"}]], "Input",
 CellChangeTimes->{{3.90982161295566*^9, 3.909821617199926*^9}, {
   3.909822022686735*^9, 3.90982202508573*^9}, {3.909822133065858*^9, 
