Cell[BoxData[
 FormBox[
  FractionBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       SubscriptBox["x", "t"]}], "+", "x", "-", "1"}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", " ", 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["x", "t"], "-", "1"}], ")"}], "2"], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"x", "-", "2"}], ")"}], " ", "x"}]}], ")"}], " ", 
       RowBox[{"log", "(", 
        FractionBox[
         RowBox[{
          SqrtBox["\[Lambda]"], "-", 
          SubscriptBox["x", "t"], "+", "x", "+", "1"}], 
         RowBox[{"2", " ", 
          SqrtBox["x"]}]], ")"}]}], "+", 
      RowBox[{
       SqrtBox["\[Lambda]"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", " ", 
          SubscriptBox["x", "t"]}], "-", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["x", "t"], "+", "x", "-", "1"}], ")"}], " ", 
          RowBox[{"log", "(", "x", ")"}]}]}], ")"}]}]}], ")"}]}], 
   RowBox[{"128", " ", 
    SuperscriptBox["\[Pi]", "4"], " ", 
    SqrtBox["\[Lambda]"], " ", 
    SubsuperscriptBox["x", "t", "2"]}]], TraditionalForm]], "Output",
