             OverscriptBox["\[Gamma]", "_"], "6"]}]}], "-", 
          RowBox[{"2", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              SuperscriptBox["p1", "\[Mu]"], " ", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"\[Gamma]", "\[CenterDot]", "p2"}], ")"}], ".", 
               SuperscriptBox[
                OverscriptBox["\[Gamma]", "_"], "6"]}]}], "+", 
             RowBox[{
              SuperscriptBox["p2", "\[Mu]"], " ", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"\[Gamma]", "\[CenterDot]", "p1"}], ")"}], ".", 
               SuperscriptBox[
                OverscriptBox["\[Gamma]", "_"], "6"]}]}]}], ")"}]}]}], 
         ")"}]}], 
       SuperscriptBox["s", "2"]], "-", 
      FractionBox[
       RowBox[{
        RowBox[{
         SuperscriptBox["\[Gamma]", 
          FormBox[
           FormBox["\[Mu]",
            TraditionalForm],
           TraditionalForm]], ".", 
         SuperscriptBox[
          OverscriptBox["\[Gamma]", "_"], 
          FormBox["6",
           TraditionalForm]]}], " ", 
        SubsuperscriptBox["T", 
         RowBox[{
          FormBox[
           FormBox["c2",
            TraditionalForm],
           TraditionalForm], 
          FormBox[
           FormBox["c1",
            TraditionalForm],
           TraditionalForm]}], 
         FormBox[
          FormBox["cc3",
