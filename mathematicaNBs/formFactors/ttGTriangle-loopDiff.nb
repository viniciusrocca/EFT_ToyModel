Cell[BoxData[{
 RowBox[{
  RowBox[{"ruleOnShell", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"GSD", "[", "p1", "]"}], ".", 
       RowBox[{"u", "[", "p1", "]"}]}], "->", 
      RowBox[{"MT", "*", 
       RowBox[{"u", "[", "p1", "]"}]}]}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"uBar", "[", "p2", "]"}], ".", 
       RowBox[{"GSD", "[", "p2", "]"}]}], "->", 
      RowBox[{"MT", "*", 
       RowBox[{"uBar", "[", "p2", "]"}]}]}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ampEFT1c", "=", 
   RowBox[{"ampEFT1b", "//.", "ruleOnShell"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"organizedAmp", "=", 
  RowBox[{"Collect", "[", 
   RowBox[{"ampEFT1c", ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Ga", "[", "mu", "]"}], ",", 
      RowBox[{"FV", "[", 
       RowBox[{"p1", ",", "mu"}], "]"}], ",", 
      RowBox[{"FV", "[", 
       RowBox[{"p2", ",", "mu"}], "]"}]}], "}"}], ",", "Simplify"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"coeffList", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<Gamma Term\>\"", "->", 
