Cell[BoxData[
 RowBox[{"deltaCTLexp", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"deltaCTL", "/.", "SubsCT"}], ")"}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"xC", "\[Rule]", "x"}], ",", 
      RowBox[{"xT", "\[Rule]", " ", 
       SubscriptBox["x", "t"]}], ",", 
      RowBox[{"lA", "\[Rule]", " ", "\[Lambda]"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.909821365654497*^9, 3.909821366472928*^9}, {
  3.9098214032879257`*^9, 3.9098214325672617`*^9}, {3.909822011533216*^9, 
  3.9098220153640423`*^9}, {3.909822099921864*^9, 3.9098221265252953`*^9}, {
  3.909822193521056*^9, 3.9098222094738293`*^9}},
 CellLabel->
  "In[132]:=",ExpressionUUID->"18e560bc-6285-474d-83fe-d49380bfef40"],

Cell[BoxData[
 FormBox[
  FractionBox[
   RowBox[{
    RowBox[{"2", " ", 
     SqrtBox["\[Lambda]"], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SubscriptBox["x", "t"], " ", 
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["x", "t"], "+", 
          RowBox[{"2", " ", "x"}], "+", 
          RowBox[{"log", "(", "x", ")"}], "-", "2"}], ")"}]}], "-", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"x", "-", "1"}], ")"}], "2"], " ", 
        RowBox[{"log", "(", "x", ")"}]}]}], ")"}]}], "-", 
    RowBox[{"4", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SubscriptBox["x", "t"], " ", 
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["x", "t"], "+", 
          SuperscriptBox["x", "2"], "+", "x", "-", "2"}], ")"}]}], "-", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"x", "-", "1"}], ")"}], "3"]}], ")"}], " ", 
     RowBox[{"log", "(", 
      FractionBox[
       RowBox[{
        SqrtBox["\[Lambda]"], "-", 
        SubscriptBox["x", "t"], "+", "x", "+", "1"}], 
       RowBox[{"2", " ", 
        SqrtBox["x"]}]], ")"}]}]}], 
   RowBox[{"128", " ", 
    SuperscriptBox["\[Pi]", "4"], " ", 
    SqrtBox["\[Lambda]"], " ", 
    SubsuperscriptBox["x", "t", "2"]}]], TraditionalForm]], "Output",
 CellChangeTimes->{3.97922844263067*^9, 3.9792284863701344`*^9, 
  3.979228823700507*^9},
 CellLabel->
  "Out[132]=",ExpressionUUID->"90699b50-0ffb-42f2-9653-29a940cfecba"]
}, Open  ]],

