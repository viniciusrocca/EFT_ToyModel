              SubscriptBox["\<\"\[PartialD]\"\>", "FR$mu"], "[", 
              RowBox[{
               SubscriptBox["\<\"\[PartialD]\"\>", "FR$nu"], "[", 
               RowBox[{"a2_", "[", "FR$nu", "]"}], "]"}], "]"}]}], "\[Rule]", 
            "0"}]}]}], ";", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"!", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"NumericQ", "[", 
               RowBox[{"NumericalValue", "[", "tmp1", "]"}], "]"}], "&&", 
              RowBox[{"NumericQ", "[", 
               RowBox[{"NumericalValue", "[", "tmp2", "]"}], "]"}]}], ")"}]}],
            ",", 
           RowBox[{"Print", "[", 
            
            RowBox[{"\<\"Warning: non numerical value encountered for \"\>", 
             ",", 
             RowBox[{"ToString", "[", 
              RowBox[{
              "fcl1", "\[LeftDoubleBracket]", "$nn", 
               "\[RightDoubleBracket]"}], "]"}], 
             ",", "\<\". Unable to check normalisation.\"\>"}], "]"}]}], 
          "]"}], ";", 
         RowBox[{"ck", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"fcl1", "\[LeftDoubleBracket]", 
              RowBox[{"$nn", ",", "1"}], "\[RightDoubleBracket]"}], "===", 
             RowBox[{"fcl1", "\[LeftDoubleBracket]", 
              RowBox[{"$nn", ",", "2"}], "\[RightDoubleBracket]"}]}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"NumericalValue", "[", "tmp1", "]"}], "\[Equal]", 
              RowBox[{"-", "0.5`"}]}], "&&", 
             RowBox[{
              RowBox[{"NumericalValue", "[", "tmp2", "]"}], "\[Equal]", 
              "0.5`"}]}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"NumericalValue", "[", "tmp1", "]"}], "\[Equal]", 
              RowBox[{"-", "1.`"}]}], "&&", 
             RowBox[{
              RowBox[{"NumericalValue", "[", "tmp2", "]"}], "\[Equal]", 
              "1.`"}]}]}], "]"}]}], ";", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"ck", "=!=", "True"}], ",", 
           RowBox[{"Print", "[", 
            RowBox[{"\<\"Warning: Kinetic term for \"\>", ",", 
             RowBox[{"ToString", "[", 
              RowBox[{
              "fcl1", "\[LeftDoubleBracket]", "$nn", 
               "\[RightDoubleBracket]"}], "]"}], 
             ",", "\<\" seems not to be correctly normalized.\"\>"}], "]"}]}],
           "]"}], ";", 
         RowBox[{"cktot", "=", 
          RowBox[{"cktot", "&&", "ck"}]}]}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"$nn", ",", 
        RowBox[{"Length", "[", "fcl", "]"}]}], "}"}]}], "]"}], ";", 
    RowBox[{"If", "[", 
