         RowBox[{"tmp1", "=", 
          RowBox[{
           RowBox[{"tmpterm", "/.", "\[VeryThinSpace]", 
            RowBox[{
             RowBox[{
              RowBox[{"a1_", "[", "FR$mu", "]"}], " ", 
              RowBox[{
               SubscriptBox["\<\"\[PartialD]\"\>", "FR$nu"], "[", 
               RowBox[{
                SubscriptBox["\<\"\[PartialD]\"\>", "FR$nu"], "[", 
                RowBox[{"a2_", "[", "FR$mu", "]"}], "]"}], "]"}]}], "\[Rule]",
              "0"}]}], "/.", "\[VeryThinSpace]", 
           RowBox[{
            RowBox[{
