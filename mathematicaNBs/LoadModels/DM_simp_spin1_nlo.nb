Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"deltaSP = deltaSM = deltaS = -MT deltaSMp = \"\>", 
   "\[InvisibleSpace]", 
   FractionBox[
    RowBox[{"mPsiT", " ", 
     RowBox[{"(", 
      RowBox[{
       FractionBox[
        RowBox[{
         RowBox[{
          RowBox[{"-", "4"}], " ", 
          SqrtBox["lB"], " ", "xT"}], "+", 
         RowBox[{"4", " ", 
          SqrtBox["lB"], " ", "xC", " ", "xT"}], "-", 
         RowBox[{"2", " ", 
          SqrtBox["lB"], " ", 
          SuperscriptBox["xT", "2"]}], "+", 
         RowBox[{"2", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "+", "lB", "-", 
            RowBox[{"lB", " ", "xC"}], "+", 
            SuperscriptBox["xC", "3"], "+", 
            SuperscriptBox["xT", "2"], "-", 
            RowBox[{
             SuperscriptBox["xC", "2"], " ", 
             RowBox[{"(", 
              RowBox[{"3", "+", 
               RowBox[{"2", " ", "xT"}]}], ")"}]}], "+", 
            RowBox[{"xC", " ", 
             RowBox[{"(", 
              RowBox[{"3", "+", 
               RowBox[{"2", " ", "xT"}], "+", 
               SuperscriptBox["xT", "2"]}], ")"}]}]}], ")"}], " ", 
          RowBox[{"ArcTan", "[", 
           FractionBox[
            SqrtBox["lB"], 
            RowBox[{"1", "+", "xC", "-", "xT"}]], "]"}]}]}], 
        SqrtBox[
         RowBox[{"lB", " ", 
          SuperscriptBox["xT", "3"]}]]], "+", 
       FractionBox[
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", "xC"}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{"2", "-", 
           RowBox[{"2", " ", "xC"}], "+", "xT"}], ")"}], " ", 
         RowBox[{"Log", "[", "xC", "]"}]}], 
        SuperscriptBox["xT", 
         RowBox[{"3", "/", "2"}]]], "-", 
       FractionBox[
        RowBox[{"2", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", "xC"}], ")"}], " ", 
         RowBox[{"Log", "[", 
          FractionBox[
           RowBox[{
            SuperscriptBox["mPsiT", "2"], " ", 
            SqrtBox["xC"]}], 
           SuperscriptBox["\[Mu]", "2"]], "]"}]}], 
        SqrtBox["xT"]], "-", 
       FractionBox[
        RowBox[{"4", " ", 
         RowBox[{"Log", "[", 
          FractionBox["mPsiT", "\[Mu]"], "]"}]}], 
        SqrtBox["xT"]], "+", 
       FractionBox[
        RowBox[{"4", " ", "xC", " ", 
         RowBox[{"Log", "[", 
          FractionBox[
           RowBox[{"mPsiT", " ", 
            SqrtBox["xC"]}], "\[Mu]"], "]"}]}], 
        SqrtBox["xT"]]}], ")"}]}], 
    RowBox[{"64", " ", 
     SuperscriptBox["\[Pi]", "4"]}]]}],
  SequenceForm[
  "deltaSP = deltaSM = deltaS = -MT deltaSMp = ", 
   Rational[1, 64] $CellContext`mPsiT 
   Pi^(-4) (($CellContext`lB $CellContext`xT^3)^
      Rational[-1, 2] ((-4) $CellContext`lB^Rational[1, 2] $CellContext`xT + 
      4 $CellContext`lB^Rational[1, 2] $CellContext`xC $CellContext`xT - 
      2 $CellContext`lB^Rational[1, 2] $CellContext`xT^2 + 
      2 (-1 + $CellContext`lB - $CellContext`lB $CellContext`xC + \
$CellContext`xC^3 + $CellContext`xT^2 - $CellContext`xC^2 (3 + 
         2 $CellContext`xT) + $CellContext`xC (3 + 
          2 $CellContext`xT + $CellContext`xT^2)) 
       ArcTan[$CellContext`lB^Rational[1, 2]/(
         1 + $CellContext`xC - $CellContext`xT)]) + (-1 + $CellContext`xC) \
$CellContext`xT^Rational[-3, 2] (2 - 2 $CellContext`xC + $CellContext`xT) 
     Log[$CellContext`xC] - 
    2 (-1 + $CellContext`xC) $CellContext`xT^Rational[-1, 2] 
    Log[$CellContext`mPsiT^2 $CellContext`xC^Rational[1, 2] 
      FeynRules`\[Mu]^(-2)] - 4 $CellContext`xT^Rational[-1, 2] 
    Log[$CellContext`mPsiT/FeynRules`\[Mu]] + 
    4 $CellContext`xC $CellContext`xT^Rational[-1, 2] 
     Log[$CellContext`mPsiT $CellContext`xC^Rational[1, 2]/FeynRules`\[Mu]])],
  
  Editable->False]], "Print",
