Cell[CellGroupData[{

Cell["Case 1 (On-shell decay): mPsiT \[NotEqual] MT, mPsiT > mSDM + MT", \
"Subsection",
 CellChangeTimes->{{3.9791421505031147`*^9, 
  3.979142199350357*^9}},ExpressionUUID->"ecf86943-cb0a-4812-bc8f-\
3dcdb9146867"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Assumptions1", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"mSDM", " ", "\[NotEqual]", " ", "MT"}], ",", 
     RowBox[{"mPsiT", ">", 
      RowBox[{"(", 
       RowBox[{"mSDM", "+", "MT"}], ")"}]}], ",", 
     RowBox[{"xT", ">", "0"}], ",", 
     RowBox[{"xC", ">", "0"}], ",", 
     RowBox[{"lA", ">", "0"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"$Assumptions", "=", 
   RowBox[{"Join", "[", 
    RowBox[{"Assumptions0", ",", "Assumptions1"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"subs1", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"MT", "\[Rule]", " ", 
      RowBox[{
       SqrtBox["xT"], " ", "mPsiT"}]}], ",", 
     RowBox[{"mSDM", "\[Rule]", " ", 
      RowBox[{
       SqrtBox["xC"], " ", "mPsiT"}]}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"subs2", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"xC", "^", "2"}], " ", "-", " ", 
       RowBox[{"2", 
        RowBox[{"(", 
         RowBox[{"xT", "+", "1"}], ")"}], " ", "xC"}], " ", "+", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"xT", "-", "1"}], ")"}], "^", "2"}]}], ")"}], "\[Rule]", " ",
      "lA"}], "}"}]}], ";"}]}], "Input",
 CellChangeTimes->{
  3.979142226122905*^9, {3.979142277482456*^9, 3.979142287497113*^9}, {
   3.9791431383061028`*^9, 3.9791431478707438`*^9}},
 CellLabel->"In[19]:=",ExpressionUUID->"c4b14931-bf78-49b2-8014-2e54d0d2ba22"],

