Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"deltaSelfB2", "=", 
  RowBox[{"Collect", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Collect", "[", 
      RowBox[{"deltaSelfB1", ",", 
       RowBox[{"{", 
        RowBox[{"\[Epsilon]", ",", 
         RowBox[{"Log", "[", "a_", "]"}]}], "}"}], ",", "FullSimplify"}], 
      "]"}], "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Log", "[", 
         FractionBox["a_", "\[Mu]"], "]"}], "\[Rule]", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           FractionBox["1", "2"]}], 
          RowBox[{"Log", "[", 
           FractionBox[
            RowBox[{"\[Mu]", "^", "2"}], 
            RowBox[{"mPsiT", "^", "2"}]], "]"}]}], "+", 
         RowBox[{"Log", "[", 
          FractionBox["a", "mPsiT"], "]"}]}]}], ",", 
       RowBox[{
        RowBox[{"Log", "[", 
         FractionBox["a_", 
          RowBox[{"\[Mu]", "^", "2"}]], "]"}], "\[Rule]", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"Log", "[", 
           FractionBox[
            RowBox[{"\[Mu]", "^", "2"}], 
            RowBox[{"mPsiT", "^", "2"}]], "]"}]}], "+", 
         RowBox[{"Log", "[", 
          FractionBox["a", 
           RowBox[{"mPsiT", "^", "2"}]], "]"}]}]}]}], " ", "}"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"\[Epsilon]", ",", 
