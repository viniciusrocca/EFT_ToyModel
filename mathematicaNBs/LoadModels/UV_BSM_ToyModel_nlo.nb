Cell[BoxData[{
 RowBox[{
  RowBox[{"Assumptions1", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"mSDM", " ", "\[NotEqual]", " ", "MT"}], ",", 
     RowBox[{"mPsiT", ">", 
      RowBox[{"(", 
       RowBox[{"mSDM", "+", "MT"}], ")"}]}], ",", 
     RowBox[{"xT", ">", "0"}], ",", 
     RowBox[{"xC", ">", "0"}], ",", 
     RowBox[{"lA", ">", "0"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"$Assumptions", "=", 
   RowBox[{"Join", "[", 
    RowBox[{"Assumptions0", ",", "Assumptions1"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"subs1", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"MT", "\[Rule]", " ", 
      RowBox[{
       SqrtBox["xT"], " ", "mPsiT"}]}], ",", 
     RowBox[{"mSDM", "\[Rule]", " ", 
      RowBox[{
       SqrtBox["xC"], " ", "mPsiT"}]}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"subs2", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"xC", "^", "2"}], " ", "-", " ", 
       RowBox[{"2", 
        RowBox[{"(", 
         RowBox[{"xT", "+", "1"}], ")"}], " ", "xC"}], " ", "+", " ", 
